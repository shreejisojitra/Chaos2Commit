# AI Solution Builder — Environment Configuration Example
# ─────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is git-ignored; .env.example is safe to commit.
# ─────────────────────────────────────────────────────────────────

# OpenAI API key (required for AI features)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# OpenAI model to use (optional — defaults to gpt-4.1-mini)
# OPENAI_MODEL=gpt-4.1-mini

# Server port (optional — defaults to 3847)
# PORT=3847

# Session secret — change this to a long random string in production
SESSION_SECRET=asb-dev-secret-change-in-production
